import React, { useEffect, useRef, useState, useCallback } from 'react';
import styles from './ComparadorVersiones.module.css';
import { supabase } from '../../db/supabase';

// ─────────────────────────────────────────────────────────── Types ──
interface OrdenTrabajo {
  id: string;
  ot: string;
  estado: string;
  prioridad: string;
  responsable: string;
  rubro: string;
  comentarios?: string;
  ubicacion?: string;
  pos_x?: number;
  pos_y?: number;
  campos?: Record<string, unknown>;
  fecha_ingreso?: string;
  obra?: string;
  unidad_amenities?: string;
  descripcion?: string;
  en_garantia?: boolean;
  asiste_facility?: boolean;
  costo?: number;
  nivel_riesgo?: 'Bajo' | 'Medio' | 'Alto' | 'Extremo' | null;
  rubro_secundario?: string[];
  contratistas?: string[];
  fecha_inicio_trabajos?: string;
  porcentaje_avance?: number;
  fecha_fin_trabajos?: string;
  reincidencia?: boolean;
  potencialmente_conflictivo?: boolean;
  acta_conformidad?: 'Pendiente' | 'enviada' | 'firmada' | 'no aplica';
  informe_relevamiento?: 'Pendiente' | 'enviada' | 'no aplica';
  informe_avance?: 'Pendiente' | 'enviada' | 'no aplica';
  informe_cierre?: 'Pendiente' | 'enviada' | 'no aplica';
  acta_conformidad_url?: string;
  informe_relevamiento_url?: string;
  informe_avance_url?: string;
  informe_cierre_url?: string;
}

interface VersionSnapshot {
  ordenes?: OrdenTrabajo[];
  [key: string]: unknown;
}

interface Version {
  id: string;
  nombre: string;
  created_at: string;
  snapshot: VersionSnapshot;
}

interface DiffEntry {
  orden_id: string;
  ot: string;
  campo: string;
  valA: string;
  valB: string;
  soloEnA: boolean;
  soloEnB: boolean;
  posMovida?: boolean;
  fromX?: number;
  fromY?: number;
  toX?: number;
  toY?: number;
}

interface Props {
  proyectoId: string;
  planoUrl: string;
  proyectoNombre: string;
  onCerrar: () => void;
}

// ──────────────────────────────────────────────────── Constants ──

const ESTADO_COLOR: Record<string, string> = {
  'Pendiente':  '#EF4444',
  'En proceso': '#2462C9',
  'Cerrada':    '#22C55E',
  'No aplica':  '#9CA3AF',
};

const CAMPOS_DIFF = [
  'estado', 'prioridad', 'responsable',
  'rubro', 'comentarios', 'ubicacion',
];

// ──────────────────────────────────────────────────── Helpers ──

const esPDF = (url: string) => url.toLowerCase().includes('.pdf');

function calcularDiffs(a: OrdenTrabajo[], b: OrdenTrabajo[]): DiffEntry[] {
  const diffs: DiffEntry[] = [];
  const mapA = new Map(a.map(o => [o.id, o]));
  const mapB = new Map(b.map(o => [o.id, o]));
  const allIds = new Set([...mapA.keys(), ...mapB.keys()]);

  for (const id of allIds) {
    const oa = mapA.get(id);
    const ob = mapB.get(id);

    if (!oa) {
      diffs.push({
        orden_id: id, ot: ob!.ot, campo: 'OT',
        valA: '—', valB: 'Nueva',
        soloEnA: false, soloEnB: true,
      });
      continue;
    }
    if (!ob) {
      diffs.push({
        orden_id: id, ot: oa.ot, campo: 'OT',
        valA: 'Eliminada', valB: '—',
        soloEnA: true, soloEnB: false,
      });
      continue;
    }

    for (const campo of CAMPOS_DIFF) {
      const va = String((oa as unknown as Record<string, unknown>)[campo] ?? '');
      const vb = String((ob as unknown as Record<string, unknown>)[campo] ?? '');
      if (va !== vb) {
        diffs.push({
          orden_id: id, ot: oa.ot, campo,
          valA: va, valB: vb,
          soloEnA: false, soloEnB: false,
        });
      }
    }

    // Position change (threshold 0.005 on 0–1 scale)
    const dx = Math.abs((oa.pos_x ?? 0) - (ob.pos_x ?? 0));
    const dy = Math.abs((oa.pos_y ?? 0) - (ob.pos_y ?? 0));
    if (dx > 0.005 || dy > 0.005) {
      diffs.push({
        orden_id: id, ot: oa.ot, campo: 'Posición',
        valA: `(${Math.round((oa.pos_x ?? 0) * 100)}%, ${Math.round((oa.pos_y ?? 0) * 100)}%)`,
        valB: `(${Math.round((ob.pos_x ?? 0) * 100)}%, ${Math.round((ob.pos_y ?? 0) * 100)}%)`,
        soloEnA: false, soloEnB: false,
        posMovida: true,
        fromX: oa.pos_x ?? 0, fromY: oa.pos_y ?? 0,
        toX: ob.pos_x ?? 0,   toY: ob.pos_y ?? 0,
      });
    }
  }

  return diffs;
}

// ──────────────────────────────────────────────────── Component ──

export const ComparadorVersiones: React.FC<Props> = ({
  proyectoId,
  planoUrl,
  proyectoNombre,
  onCerrar,
}) => {
  const [versiones, setVersiones]       = useState<Version[]>([]);
  const [idA, setIdA]                   = useState('');
  const [idB, setIdB]                   = useState('');
  const [comparando, setComparando]     = useState(false);
  const [diffs, setDiffs]               = useState<DiffEntry[]>([]);
  const [ordenesA, setOrdenesA]         = useState<OrdenTrabajo[]>([]);
  const [ordenesB, setOrdenesB]         = useState<OrdenTrabajo[]>([]);
  const [showLayerA, setShowLayerA]     = useState(true);
  const [showLayerB, setShowLayerB]     = useState(true);
  const [selectedOT, setSelectedOT]     = useState<string | null>(null);
  const [cargando, setCargando]         = useState(true);
  const [pdfCanvasUrl, setPdfCanvasUrl] = useState<string | null>(null);
  const [loadingPdf, setLoadingPdf]     = useState(false);
  const contenedorRef = useRef<HTMLDivElement>(null);

  // ── Rectángulo real de la imagen renderizada (px, relativo al wrapper) ──
  // Los marcadores y las flechas se anclan a este rect, NO al contenedor,
  // para que pos_x/pos_y (fracciones 0–1 del plano real) caigan exactas
  // aunque la imagen quede con letterbox dentro del wrapper.
  const imgRef = useRef<HTMLImageElement>(null);
  const [imgRect, setImgRect] = useState<{ left: number; top: number; width: number; height: number } | null>(null);

  const medirImagen = useCallback(() => {
    const img = imgRef.current;
    const wrapper = contenedorRef.current;
    if (!img || !wrapper || !img.naturalWidth || !img.naturalHeight) {
      setImgRect(null);
      return;
    }

    // BCR da coordenadas de viewport → las relativizamos al wrapper.
    // Funciona con cualquier CSS (flex, absolute, etc.) y sin depender
    // del offsetParent, que varía según la cadena de positioned ancestors.
    const imgBCR  = img.getBoundingClientRect();
    const wrapBCR = wrapper.getBoundingClientRect();

    const elemW = imgBCR.width;
    const elemH = imgBCR.height;
    const natAspect  = img.naturalWidth / img.naturalHeight;
    const elemAspect = elemW / elemH;

    let left: number, top: number, width: number, height: number;

    if (Math.abs(natAspect - elemAspect) < 0.01) {
      // Sin letterbox apreciable — el elemento coincide con el contenido.
      left   = imgBCR.left - wrapBCR.left;
      top    = imgBCR.top  - wrapBCR.top;
      width  = elemW;
      height = elemH;
    } else if (natAspect > elemAspect) {
      // Imagen más ancha que el elemento → constrained by width,
      // letterbox arriba y abajo (barras horizontales).
      width  = elemW;
      height = elemW / natAspect;
      left   = imgBCR.left - wrapBCR.left;
      top    = imgBCR.top  - wrapBCR.top + (elemH - height) / 2;
    } else {
      // Imagen más alta que el elemento → constrained by height,
      // letterbox izquierda y derecha (barras verticales).
      height = elemH;
      width  = elemH * natAspect;
      top    = imgBCR.top  - wrapBCR.top;
      left   = imgBCR.left - wrapBCR.left + (elemW - width) / 2;
    }

    setImgRect({ left, top, width, height });
  }, []);

  // Re-medir al montar/cambiar plano y ante cualquier resize del contenedor.
  useEffect(() => {
    const id = requestAnimationFrame(medirImagen);
    window.addEventListener('resize', medirImagen);
    let ro: ResizeObserver | null = null;
    if (contenedorRef.current && 'ResizeObserver' in window) {
      ro = new ResizeObserver(() => medirImagen());
      ro.observe(contenedorRef.current);
    }
    return () => {
      cancelAnimationFrame(id);
      window.removeEventListener('resize', medirImagen);
      ro?.disconnect();
    };
  }, [medirImagen, pdfCanvasUrl, planoUrl, comparando]);

  // ── Fetch versions ──────────────────────────────────────────

  useEffect(() => {
    (async () => {
      const { data, error } = await supabase
        .from('versiones')
        .select('id, nombre, created_at, snapshot')
        .eq('proyecto_id', proyectoId)
        .order('created_at', { ascending: false });

      if (!error && data && data.length > 0) {
        setVersiones(data as Version[]);
        if (data.length >= 2) {
          setIdB(data[0].id);
          setIdA(data[1].id);
        } else {
          setIdA(data[0].id);
        }
      }
      setCargando(false);
    })();
  }, [proyectoId]);

  // ── PDF rendering via pdf.js ───────────────────────────────

  useEffect(() => {
    if (!planoUrl || !esPDF(planoUrl)) return;

    let cancelled = false;
    setLoadingPdf(true);
    setPdfCanvasUrl(null);

    (async () => {
      try {
        const pdfjsLib = await import('pdfjs-dist');
        pdfjsLib.GlobalWorkerOptions.workerSrc =
          'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

        const pdf = await pdfjsLib.getDocument({
          url: planoUrl,
          disableRange: true,
          disableStream: true,
        }).promise;

        const page = await pdf.getPage(1);
        const baseViewport = page.getViewport({ scale: 1 });
        const dpr = window.devicePixelRatio || 1;
        const containerWidth = contenedorRef.current?.clientWidth ?? 800;
        const scale = (containerWidth / baseViewport.width) * dpr;
        const viewport = page.getViewport({ scale });

        const canvas = document.createElement('canvas');
        canvas.width  = viewport.width;
        canvas.height = viewport.height;
        const ctx = canvas.getContext('2d')!;

        ctx.fillStyle = 'white';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        await page.render({ canvasContext: ctx, viewport }).promise;

        const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const d = imgData.data;
        for (let i = 0; i < d.length; i += 4) {
          const luma = 0.299 * d[i] + 0.587 * d[i + 1] + 0.114 * d[i + 2];
          const val  = Math.max(0, Math.min(255, Math.round((luma - 30) / 185 * 255)));
          d[i] = d[i + 1] = d[i + 2] = val;
        }
        ctx.putImageData(imgData, 0, 0);

        if (!cancelled) setPdfCanvasUrl(canvas.toDataURL('image/png'));
      } catch (err) {
        console.error('[ComparadorVersiones] PDF render error:', err);
      } finally {
        if (!cancelled) setLoadingPdf(false);
      }
    })();

    return () => { cancelled = true; };
  }, [planoUrl]);

  // ── Compare ─────────────────────────────────────────────────

  const handleComparar = () => {
    if (!idA || !idB || idA === idB) return;

    const vA = versiones.find(v => v.id === idA);
    const vB = versiones.find(v => v.id === idB);
    const oa = vA?.snapshot?.ordenes ?? [];
    const ob = vB?.snapshot?.ordenes ?? [];

    setOrdenesA(oa);
    setOrdenesB(ob);
    setDiffs(calcularDiffs(oa, ob));
    setSelectedOT(null);
    setComparando(true);
  };

  // ── Derived ─────────────────────────────────────────────────

  const arrows     = diffs.filter(d => d.posMovida);
  const cambios    = diffs.filter(d => !d.soloEnA && !d.soloEnB && !d.posMovida).length;
  const nuevas     = diffs.filter(d => d.soloEnB).length;
  const eliminadas = diffs.filter(d => d.soloEnA).length;
  const movidas    = diffs.filter(d => d.posMovida).length;

  const diffsVisibles = diffs.filter(d => !selectedOT || d.orden_id === selectedOT);
  const planoEsPDF = esPDF(planoUrl);

  // Posición de un marcador en px, anclada al rect real de la imagen.
  // Fallback a % del wrapper si aún no se midió (primer frame).
  const posMarcador = (x?: number, y?: number): React.CSSProperties =>
    imgRect
      ? {
          left: `${imgRect.left + (x ?? 0) * imgRect.width}px`,
          top:  `${imgRect.top  + (y ?? 0) * imgRect.height}px`,
        }
      : { left: `${(x ?? 0) * 100}%`, top: `${(y ?? 0) * 100}%` };

  // El SVG de flechas se superpone EXACTAMENTE sobre la imagen (no el wrapper).
  const svgStyle: React.CSSProperties | undefined = imgRect
    ? {
        position: 'absolute',
        left: imgRect.left,
        top: imgRect.top,
        width: imgRect.width,
        height: imgRect.height,
        right: 'auto',
        bottom: 'auto',
      }
    : undefined;

  // ── Render ──────────────────────────────────────────────────

  return (
    <div className={styles.workspace}>

      {/* ═══ LEFT PANEL ═══════════════════════════════════════ */}
      <div className={styles.leftPanel}>

        <div className={styles.leftHeader}>
          <button className={styles.backBtn} onClick={onCerrar}>← Volver</button>
          <div className={styles.proyectoNombre} title={proyectoNombre}>
            {proyectoNombre}
          </div>
          <span className={styles.comparadorBadge}>Comparador de versiones</span>
        </div>

        {cargando ? (
          <p className={styles.hint}>Cargando versiones...</p>
        ) : versiones.length < 2 ? (
          <p className={styles.hint}>
            Se necesitan al menos 2 versiones guardadas para comparar.
          </p>
        ) : (
          <>
            {comparando && (
              <div className={styles.statsGrid}>
                <div className={styles.statCard}>
                  <span className={`${styles.statNum} ${styles.statNumCambios}`}>{cambios}</span>
                  <span className={styles.statLabel}>Cambios</span>
                </div>
                <div className={styles.statCard}>
                  <span className={`${styles.statNum} ${styles.statNumNuevas}`}>{nuevas}</span>
                  <span className={styles.statLabel}>Nuevas</span>
                </div>
                <div className={styles.statCard}>
                  <span className={`${styles.statNum} ${styles.statNumEliminadas}`}>{eliminadas}</span>
                  <span className={styles.statLabel}>Eliminadas</span>
                </div>
                <div className={styles.statCard}>
                  <span className={`${styles.statNum} ${styles.statNumMovidas}`}>{movidas}</span>
                  <span className={styles.statLabel}>Movidas</span>
                </div>
              </div>
            )}

            <div className={styles.versionBlock}>
              <label className={styles.versionPill}>
                <span className={`${styles.versionDot} ${styles.versionDotA}`} />
                Versión A · anterior
              </label>
              <select
                className={styles.versionSelect}
                value={idA}
                onChange={e => setIdA(e.target.value)}
              >
                {versiones.map(v => (
                  <option key={v.id} value={v.id}>
                    {v.nombre} · {new Date(v.created_at).toLocaleDateString('es-PY')}
                  </option>
                ))}
              </select>
            </div>

            <div className={styles.versionBlock}>
              <label className={styles.versionPill}>
                <span className={styles.versionDot} />
                Versión B · actual
              </label>
              <select
                className={styles.versionSelect}
                value={idB}
                onChange={e => setIdB(e.target.value)}
              >
                {versiones.map(v => (
                  <option key={v.id} value={v.id}>
                    {v.nombre} · {new Date(v.created_at).toLocaleDateString('es-PY')}
                  </option>
                ))}
              </select>
            </div>

            <button
              className={styles.compareBtn}
              onClick={handleComparar}
              disabled={!idA || !idB || idA === idB}
            >
              Comparar versiones
            </button>

            {comparando && (
              <div className={styles.capasBlock}>
                <div className={styles.capasTitle}>Capas visibles</div>
                <label className={styles.capaRow}>
                  <input
                    className={styles.capaCheck}
                    type="checkbox"
                    checked={showLayerA}
                    onChange={e => setShowLayerA(e.target.checked)}
                  />
                  <span className={`${styles.capaDot} ${styles.capaDotA}`} />
                  <span className={styles.capaLabel}>Ver. A (anterior)</span>
                </label>
                <label className={styles.capaRow}>
                  <input
                    className={styles.capaCheck}
                    type="checkbox"
                    checked={showLayerB}
                    onChange={e => setShowLayerB(e.target.checked)}
                  />
                  <span className={styles.capaDot} />
                  <span className={styles.capaLabel}>Ver. B (actual)</span>
                </label>
              </div>
            )}
          </>
        )}
      </div>

      {/* ═══ CENTER PANEL ═════════════════════════════════════ */}
      <div className={styles.panelCenter}>
        <div className={styles.planoWrapper} ref={contenedorRef}>

          {planoEsPDF ? (
            loadingPdf ? (
              <div className={styles.pdfLoading}>
                <span className={styles.spinnerPdf} />
                Renderizando plano PDF...
              </div>
            ) : pdfCanvasUrl ? (
              <img
                ref={imgRef}
                src={pdfCanvasUrl}
                className={styles.planoImg}
                alt="Plano"
                draggable={false}
                onLoad={medirImagen}
              />
            ) : (
              <div className={styles.pdfError}>
                No se pudo renderizar el plano PDF.
              </div>
            )
          ) : (
            <img
              ref={imgRef}
              src={planoUrl}
              className={styles.planoImg}
              alt="Plano"
              draggable={false}
              onLoad={medirImagen}
            />
          )}

          {comparando && arrows.length > 0 && (
            <svg
              className={styles.svgOverlay}
              style={svgStyle}
              viewBox="0 0 100 100"
              preserveAspectRatio="none"
            >
              <defs>
                <marker
                  id="arrowhead"
                  markerWidth="3" markerHeight="3"
                  refX="1.5" refY="1.5"
                  orient="auto"
                >
                  <polygon points="0 0, 3 1.5, 0 3" fill="#CC7A00" />
                </marker>
              </defs>
              {arrows.map((d, i) => (
                <line
                  key={i}
                  x1={(d.fromX ?? 0) * 100}
                  y1={(d.fromY ?? 0) * 100}
                  x2={(d.toX ?? 0) * 100}
                  y2={(d.toY ?? 0) * 100}
                  stroke="#CC7A00"
                  strokeWidth="0.35"
                  strokeDasharray="1,0.5"
                  markerEnd="url(#arrowhead)"
                />
              ))}
            </svg>
          )}

          {comparando && showLayerA && ordenesA.map(o => (
            <div
              key={`A-${o.id}`}
              className={`${styles.marker} ${selectedOT === o.id ? styles.markerSelected : ''}`}
              style={posMarcador(o.pos_x, o.pos_y)}
              title={`[A] ${o.ot} — ${o.estado}`}
              onClick={() => setSelectedOT(prev => prev === o.id ? null : o.id)}
            >
              <div
                className={styles.markerDot}
                style={{
                  background: ESTADO_COLOR[o.estado] ?? '#94A3B8',
                  opacity: 0.5,
                }}
              />
              <span className={styles.markerLabel}>{o.ot}</span>
            </div>
          ))}

          {comparando && showLayerB && ordenesB.map(o => (
            <div
              key={`B-${o.id}`}
              className={`${styles.marker} ${styles.markerB} ${selectedOT === o.id ? styles.markerSelected : ''}`}
              style={posMarcador(o.pos_x, o.pos_y)}
              title={`[B] ${o.ot} — ${o.estado}`}
              onClick={() => setSelectedOT(prev => prev === o.id ? null : o.id)}
            >
              <div
                className={styles.markerDot}
                style={{ background: ESTADO_COLOR[o.estado] ?? '#94A3B8' }}
              />
              <span className={styles.markerLabel}>{o.ot}</span>
            </div>
          ))}

        </div>
      </div>

      {/* ═══ RIGHT PANEL ══════════════════════════════════════ */}
      <div className={styles.rightPanel}>

        <div className={styles.rightHeader}>
          <span className={styles.rightTitle}>Diferencias</span>
          <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
            {comparando && <span className={styles.totalBadge}>{diffs.length}</span>}
            {selectedOT && (
              <button
                className={styles.btnClearFilter}
                onClick={() => setSelectedOT(null)}
              >
                ✕ filtro
              </button>
            )}
          </div>
        </div>

        {!comparando ? (
          <p className={styles.hintRight}>
            Seleccioná dos versiones y presioná "Comparar versiones".
          </p>
        ) : diffs.length === 0 ? (
          <p className={styles.hintRight}>
            Las versiones seleccionadas son idénticas.
          </p>
        ) : (
          <div className={styles.tableWrap}>
            <div className={styles.tableHead}>
              <span className={styles.thCell}>OT / Campo</span>
              <span className={styles.thCell}>▼ Ver. A</span>
              <span className={styles.thCell}>▲ Ver. B</span>
            </div>

            {diffsVisibles.map((d, i) => {
              const tipo =
                d.soloEnA  ? styles.diffRowDeleted :
                d.soloEnB  ? styles.diffRowNew :
                d.posMovida? styles.diffRowMoved :
                             styles.diffRowChanged;

              return (
                <div
                  key={i}
                  className={[
                    styles.diffRow,
                    tipo,
                    selectedOT === d.orden_id ? styles.diffRowSelected : '',
                  ].filter(Boolean).join(' ')}
                  onClick={() =>
                    setSelectedOT(prev => prev === d.orden_id ? null : d.orden_id)
                  }
                >
                  <div>
                    <span className={styles.otCode}>{d.ot}</span>
                    <span className={styles.campo}>{d.campo}</span>
                  </div>
                  <div>
                    {d.soloEnA
                      ? <span className={styles.tagEliminada}>Eliminada</span>
                      : d.valA === '—' || d.valA === ''
                        ? <span className={styles.dash}>—</span>
                        : <span className={`${styles.valPill} ${styles.valA}`}>{d.valA}</span>}
                  </div>
                  <div>
                    {d.soloEnB
                      ? <span className={styles.tagNueva}>Nueva</span>
                      : d.valB === '—' || d.valB === ''
                        ? <span className={styles.dash}>—</span>
                        : <span className={`${styles.valPill} ${styles.valB}`}>{d.valB}</span>}
                  </div>
                </div>
              );
            })}
          </div>
        )}

      </div>
    </div>
  );
};